{
  "opencollection": "1.0.0",
  "info": {
    "name": "Superlinked Server Data Loader API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Data Loader",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Trigger a configured data loader",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/data-loader/:name/run",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the configured data loader."
              }
            ]
          },
          "docs": "Starts a configured batch data loader to backfill vectors from a file or external source."
        },
        {
          "info": {
            "name": "Get data loader status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/data-loader/:name/status",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the configured data loader."
              }
            ]
          },
          "docs": "Reports the progress and state of a configured data loader."
        }
      ]
    }
  ],
  "bundled": true
}